
---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';

const home = await getEntry('pages', 'home');

if (!home) {
  throw new Error('找不到首页配置文件 home.md');
}

const { Content } = await render(home);

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={home.data.title}>
  <img
    class="page-cover"
    src={home.data.coverImage}
    alt="留学认证通 - 北美及英澳学历认证与学历提升服务封面"
  />

  <header class="page-header">
    <div class="page-icon">🌎</div>
    <h1 class="page-title">{home.data.pageTitle}</h1>
  </header>

  <main class="page-body">
    <div class="contact-box">
      <h2>微信：{home.data.wechat}</h2>
      <p><strong>Email Us：{home.data.email}</strong>（备用联系方式）</p>
    </div>

    <figure>
      <img
        src={home.data.heroImage}
        alt="本科留学没能毕业怎么办 - 真实案例、解决方法、学历认证与学历提升服务"
        style="width: 100%; border-radius: 8px;"
      />
    </figure>

    <figure>
      <img
        src={home.data.serviceImage1}
        alt="GRE考试无忧与College升本科、本科未能毕业升研究生学历提升解决方案"
        style="width: 100%; border-radius: 8px;"
      />
    </figure>

    <figure>
      <img
        src={home.data.serviceImage2}
        alt="因未能正常毕业或学历丢失导致无法认证公证的学历认证解决方案"
        style="width: 100%; border-radius: 8px;"
      />
    </figure>

    <figure>
      <img
        src={home.data.serviceImage3}
        alt="服务介绍"
        style="width: 100%; border-radius: 8px;"
      />
    </figure>

    <h2>{home.data.sectionHeading}</h2>

    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`/posts/${post.slug}/`}>{post.data.title}</a>
          {post.data.description && (
            <p class="post-meta">{post.data.description}</p>
          )}
        </li>
      ))}
    </ul>

    <figure>
      <img
        src={home.data.qrImage}
        alt="金题榜名留学认证通官方微信二维码 caoffer"
        style="width: 100%; max-width: 400px; margin: 2rem auto; border-radius: 8px;"
      />
    </figure>

    <Content />
  </main>
</BaseLayout>
